# Keep the build context to what the server actually needs at runtime.
.git
.github
.gitignore
node_modules
npm-debug.log*

# Secrets must never enter an image layer.
.env
.env.*
!.env.example
secrets/
.gcp/
*-key.json
foundry-key.json

# Tests, tooling and build-control documents are not runtime artifacts.
test
tests
scripts
evidence
stages
contracts
requirements
templates
*.md
*.zip

# Local noise
.DS_Store
__pycache__/
.pytest_cache/
Dockerfile
.dockerignore
